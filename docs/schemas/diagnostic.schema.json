{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a2utils:schema:diagnostic:1",
  "title": "A2Utils diagnostic schema v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "message": {
      "type": "string"
    },
    "file": {
      "type": [
        "string",
        "null"
      ]
    },
    "line": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "column": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "basicLine": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 63999
    },
    "symbol": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "code",
    "severity",
    "message"
  ]
}
