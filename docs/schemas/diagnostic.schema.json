{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a2utils:schema:diagnostic:1",
  "title": "A2Utils diagnostic schema v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "message": {
      "type": "string"
    },
    "file": {
      "type": [
        "string",
        "null"
      ]
    },
    "line": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "column": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "basicLine": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 63999
    },
    "symbol": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual": {
      "type": [
        "string",
        "null"
      ]
    },
    "endLine": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "endColumn": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "jsonPointer": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool": {
      "type": [
        "string",
        "null"
      ]
    },
    "helpUri": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri-reference"
    },
    "related": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "edits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/edit"
            }
          }
        },
        "required": [
          "description",
          "edits"
        ]
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "column": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "endLine": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "endColumn": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "jsonPointer": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "message"
      ]
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "replacement": { "type": "string" },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "column": { "type": ["integer", "null"], "minimum": 1 },
        "endLine": { "type": ["integer", "null"], "minimum": 1 },
        "endColumn": { "type": ["integer", "null"], "minimum": 1 },
        "jsonPointer": { "type": ["string", "null"] }
      },
      "required": [
        "file",
        "replacement"
      ]
    }
  },
  "required": [
    "code",
    "severity",
    "message"
  ]
}
