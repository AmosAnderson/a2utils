{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a2utils:schema:error:2",
  "title": "A2Utils CLI error envelope v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Compatibility version for the original CLI envelope."
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "exitCode": {
          "type": "integer",
          "minimum": 1
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "urn:a2utils:schema:diagnostic:1"
          }
        }
      },
      "required": [
        "code",
        "message",
        "exitCode",
        "diagnostics"
      ]
    },
    "contractVersion": {
      "const": 2
    },
    "envelopeType": {
      "const": "error"
    },
    "schemaId": {
      "const": "urn:a2utils:schema:error:2"
    },
    "exitCode": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schemaVersion",
    "error",
    "contractVersion",
    "envelopeType",
    "schemaId",
    "exitCode"
  ]
}
