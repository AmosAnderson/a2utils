{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a2utils:schema:execution:1",
  "title": "A2Utils execution schema v1",
  "description": "Bounded Apple II execution. Environment profiles supply tool paths. A standalone routine needs no disk; project suites may omit the build disk.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "engine": {
      "enum": [
        "mame",
        "cpu"
      ],
      "default": "mame",
      "description": "Execution backend. Omission preserves the MAME default; cpu accepts only a disk-free routine."
    },
    "emulatorPath": {
      "type": "string",
      "description": "An empty value inherits the environment profile; required and nonempty without a profile."
    },
    "expectedVersion": {
      "const": "0.289"
    },
    "machine": {
      "enum": [
        "",
        "apple2",
        "apple2p",
        "apple2e",
        "apple2ee",
        "apple2c"
      ]
    },
    "romDirectory": {
      "type": "string",
      "description": "An empty value inherits the environment profile; required and nonempty without a profile."
    },
    "diskImage": {
      "type": "string"
    },
    "diskDevice": {
      "enum": [
        "flop1",
        "flop2",
        "hard1",
        "hard2"
      ]
    },
    "disks": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device",
          "image"
        ],
        "properties": {
          "device": {
            "enum": [
              "flop1",
              "flop2",
              "hard1",
              "hard2"
            ]
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "expectedSha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "inputOrder": {
            "enum": [
              null,
              "dos",
              "prodos"
            ]
          },
          "inputFileSystem": {
            "enum": [
              null,
              "dos33",
              "prodos"
            ]
          },
          "verify": {
            "type": "boolean"
          }
        }
      }
    },
    "diskAssertions": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device",
          "path"
        ],
        "properties": {
          "device": {
            "enum": [
              "flop1",
              "flop2",
              "hard1",
              "hard2"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
          },
          "exists": {
            "type": "boolean"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "hex": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Fa-f0-9 ]*$",
            "maxLength": 2097152
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "auxType": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 65535
          },
          "length": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 33554432
          }
        }
      }
    },
    "symbolicMemory": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program",
          "symbol",
          "hex"
        ],
        "properties": {
          "program": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "hex": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9 ]+$"
          },
          "offset": {
            "type": "integer"
          },
          "bank": {
            "enum": [
              null,
              "cpu",
              "main",
              "aux",
              "lc1",
              "lc2",
              "aux-lc1",
              "aux-lc2"
            ]
          }
        }
      }
    },
    "symbolicUntil": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "program",
        "symbol",
        "value"
      ],
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "offset": {
          "type": "integer"
        },
        "afterSeconds": {
          "type": "number",
          "minimum": 0
        },
        "bank": {
          "enum": [
            null,
            "cpu",
            "main",
            "aux",
            "lc1",
            "lc2",
            "aux-lc1",
            "aux-lc2"
          ]
        }
      }
    },
    "emulatedSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "hostTimeoutSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "atSeconds": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "required": [
          "atSeconds",
          "text"
        ]
      },
      "maxItems": 1024
    },
    "memory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "hex": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9 ]+$"
          },
          "bank": {
            "enum": [
              "cpu",
              "main",
              "aux",
              "lc1",
              "lc2",
              "aux-lc1",
              "aux-lc2"
            ]
          }
        },
        "required": [
          "address",
          "hex"
        ]
      },
      "maxItems": 1024
    },
    "graphicsMemory": {
      "description": "Encode each PNG with the Apple display-memory codec and compare the resulting bytes. Double-hires checks capture auxiliary and main memory explicitly.",
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedImage",
          "mode"
        ],
        "properties": {
          "expectedImage": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "lores",
              "hires",
              "hires-color",
              "dhires-mono",
              "dhires-color"
            ]
          },
          "page": {
            "enum": [
              1,
              2
            ]
          },
          "bank": {
            "enum": [
              "cpu",
              "main",
              "aux"
            ],
            "description": "Single-bank modes default to cpu. Double-hires selects aux and main automatically, so bank must be omitted or cpu."
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "dhires-mono",
                    "dhires-color"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "bank": {
                  "const": "cpu"
                }
              }
            }
          }
        ]
      }
    },
    "registers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,15}$"
          },
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "required": [
          "name",
          "value"
        ]
      },
      "maxItems": 128
    },
    "textContains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 128
    },
    "until": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "afterSeconds": {
          "type": "number",
          "minimum": 0
        },
        "bank": {
          "enum": [
            "cpu",
            "main",
            "aux",
            "lc1",
            "lc2",
            "aux-lc1",
            "aux-lc2"
          ]
        }
      },
      "required": [
        "address",
        "value"
      ]
    },
    "textPage": {
      "enum": [
        1,
        2
      ]
    },
    "screenshot": {
      "type": "boolean"
    },
    "trace": {
      "type": "boolean",
      "description": "Request bounded trace.tsv evidence. CPU rows include source columns when routine mappings exist; project MAME runs may add trace-source.tsv from build mappings."
    },
    "observeMemory": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "length"
        ],
        "properties": {
          "address": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "bank": {
            "enum": [
              "cpu",
              "main",
              "aux",
              "lc1",
              "lc2",
              "aux-lc1",
              "aux-lc2"
            ]
          }
        }
      }
    },
    "textColumns": {
      "enum": [
        40,
        80
      ]
    },
    "decodeIIeText": {
      "type": "boolean"
    },
    "debug": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "breakpoints": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "address": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 65535
              },
              "program": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "offset": {
                "type": "integer"
              },
              "afterSeconds": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 3600
              }
            },
            "oneOf": [
              {
                "required": [
                  "address"
                ],
                "properties": {
                  "address": {
                    "type": "integer"
                  },
                  "program": {
                    "type": "null"
                  },
                  "symbol": {
                    "type": "null"
                  },
                  "offset": {
                    "const": 0
                  }
                }
              },
              {
                "required": [
                  "program",
                  "symbol"
                ],
                "properties": {
                  "address": {
                    "type": "null"
                  },
                  "program": {
                    "type": "string",
                    "minLength": 1
                  },
                  "symbol": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "watchpoints": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "address": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 65535
              },
              "program": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "offset": {
                "type": "integer"
              },
              "afterSeconds": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 3600
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65536
              },
              "access": {
                "enum": [
                  "read",
                  "write",
                  "readWrite"
                ]
              }
            },
            "oneOf": [
              {
                "required": [
                  "address"
                ],
                "properties": {
                  "address": {
                    "type": "integer"
                  },
                  "program": {
                    "type": "null"
                  },
                  "symbol": {
                    "type": "null"
                  },
                  "offset": {
                    "const": 0
                  }
                }
              },
              {
                "required": [
                  "program",
                  "symbol"
                ],
                "properties": {
                  "address": {
                    "type": "null"
                  },
                  "program": {
                    "type": "string",
                    "minLength": 1
                  },
                  "symbol": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "stepInstructions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "historyInstructions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      },
      "anyOf": [
        {
          "type": "null"
        },
        {
          "required": [
            "breakpoints"
          ],
          "properties": {
            "breakpoints": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "watchpoints"
          ],
          "properties": {
            "watchpoints": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "environment": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "toolchainLock": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "storageProfile": {
      "enum": [
        "floppy",
        "cffa2"
      ]
    },
    "gamePort": {
      "enum": [
        "none",
        "joystick",
        "paddles"
      ]
    },
    "checkBasicRuntime": {
      "type": "boolean"
    },
    "textNotContains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 128
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "action": {
            "enum": [
              "wait",
              "assert",
              "keys",
              "delay",
              "input",
              "capture"
            ]
          },
          "condition": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "memory": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "address": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535
                    },
                    "hex": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9 ]+$"
                    },
                    "bank": {
                      "enum": [
                        "cpu",
                        "main",
                        "aux",
                        "lc1",
                        "lc2",
                        "aux-lc1",
                        "aux-lc2"
                      ]
                    }
                  },
                  "required": [
                    "address",
                    "hex"
                  ]
                },
                "maxItems": 1024
              },
              "memoryNotEqual": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "address": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535
                    },
                    "hex": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9 ]+$"
                    },
                    "bank": {
                      "enum": [
                        "cpu",
                        "main",
                        "aux",
                        "lc1",
                        "lc2",
                        "aux-lc1",
                        "aux-lc2"
                      ]
                    }
                  },
                  "required": [
                    "address",
                    "hex"
                  ]
                },
                "maxItems": 1024
              },
              "graphicsMemory": {
                "description": "Display-memory PNG expectations evaluated as part of this ordered condition.",
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "expectedImage",
                    "mode"
                  ],
                  "properties": {
                    "expectedImage": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mode": {
                      "enum": [
                        "lores",
                        "hires",
                        "hires-color",
                        "dhires-mono",
                        "dhires-color"
                      ]
                    },
                    "page": {
                      "enum": [
                        1,
                        2
                      ]
                    },
                    "bank": {
                      "enum": [
                        "cpu",
                        "main",
                        "aux"
                      ]
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "required": [
                          "mode"
                        ],
                        "properties": {
                          "mode": {
                            "enum": [
                              "dhires-mono",
                              "dhires-color"
                            ]
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "bank": {
                            "const": "cpu"
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "symbolicMemory": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "program",
                    "symbol",
                    "hex"
                  ],
                  "properties": {
                    "program": {
                      "type": "string",
                      "minLength": 1
                    },
                    "symbol": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hex": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9 ]+$"
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "bank": {
                      "enum": [
                        null,
                        "cpu",
                        "main",
                        "aux",
                        "lc1",
                        "lc2",
                        "aux-lc1",
                        "aux-lc2"
                      ]
                    }
                  }
                }
              },
              "registers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]{0,15}$"
                    },
                    "value": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ]
                },
                "maxItems": 128
              },
              "textContains": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 128
              },
              "textNotContains": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 128
              }
            }
          },
          "timeoutSeconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 3600
          },
          "seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 3600
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 16384
          },
          "input": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "control": {
                "enum": [
                  "paddle0",
                  "paddle1",
                  "paddle2",
                  "paddle3",
                  "button0",
                  "button1",
                  "button2",
                  "button3"
                ]
              },
              "value": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 255
              }
            },
            "required": [
              "control",
              "value"
            ]
          }
        }
      },
      "maxItems": 128
    },
    "routine": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "asm",
            "binary"
          ]
        },
        "origin": {
          "type": "integer",
          "minimum": 2048,
          "maximum": 49151
        },
        "entryPoint": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2048,
          "maximum": 49151
        },
        "entrySymbol": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "startAfterSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "maxCycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "registers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "enum": [
                  "A",
                  "X",
                  "Y",
                  "P"
                ]
              },
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "maxItems": 4
        },
        "memory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "address": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "hex": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9 ]+$"
              },
              "bank": {
                "const": "cpu"
              }
            },
            "required": [
              "address",
              "hex"
            ]
          },
          "maxItems": 128
        }
      },
      "required": [
        "source"
      ]
    },
    "cycles": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
