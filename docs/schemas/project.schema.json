{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a2utils:schema:project:1",
  "title": "A2Utils project schema v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "target": {
      "enum": [
        "apple2plus",
        "apple2e",
        "apple2enh",
        "apple2c"
      ]
    },
    "cpu": {
      "enum": [
        "6502",
        "65c02",
        null
      ]
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "pattern": "^(?:19[89][0-9]|20[0-3][0-9])-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])(?:T(?:[01][0-9]|2[0-3]):[0-5][0-9](?::00(?:\\.0{1,7})?)?Z?)?$",
      "description": "UTC or offset-free date/time, years 1980..2039, with whole-minute precision."
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fileSystem": {
          "enum": [
            "dos33",
            "prodos"
          ]
        },
        "template": {
          "type": [
            "string",
            "null"
          ]
        },
        "templateSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "blocks": {
          "type": "integer",
          "minimum": 280,
          "maximum": 65535
        },
        "container": {
          "enum": [
            "raw",
            "2mg"
          ]
        },
        "order": {
          "enum": [
            "dos",
            "prodos",
            null
          ]
        },
        "volumeName": {
          "type": "string"
        },
        "volumeNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 254
        }
      },
      "required": []
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "asm",
              "basic",
              "basic-labels",
              "binary",
              "text",
              "applesingle",
              "cc65",
              "lores",
              "hires",
              "hires-color"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "origin": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 65535
          },
          "auxType": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 65535
          },
          "entryPoint": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 65535
          },
          "replace": {
            "type": "boolean"
          },
          "resident": {
            "type": "boolean"
          },
          "checkBasic": {
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "path"
        ]
      },
      "maxItems": 1024,
      "minItems": 1
    },
    "reserve": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536
          }
        },
        "required": [
          "name",
          "start",
          "length"
        ]
      },
      "maxItems": 1024
    },
    "checkMemory": {
      "type": "boolean"
    },
    "basicWorkspaceBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "startup": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "program": {
          "type": "string"
        },
        "replace": {
          "type": "boolean"
        }
      },
      "required": [
        "program"
      ]
    },
    "cc65": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "compiler": {
          "type": "string"
        },
        "target": {
          "enum": [
            "apple2",
            "apple2enh"
          ]
        },
        "expectedVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "optimize": {
          "type": "boolean"
        },
        "additionalSources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 128
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 128
        },
        "defines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 128
        }
      },
      "required": []
    }
  },
  "required": [
    "schemaVersion",
    "files"
  ]
}
