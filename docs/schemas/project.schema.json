{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a2utils:schema:project:1",
  "title": "A2Utils project schema v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "target": {
      "enum": [
        "apple2plus",
        "apple2e",
        "apple2enh",
        "apple2c"
      ]
    },
    "cpu": {
      "enum": [
        "6502",
        "65c02",
        null
      ]
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "pattern": "^(?:19[89][0-9]|20[0-3][0-9])-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])(?:T(?:[01][0-9]|2[0-3]):[0-5][0-9](?::00(?:\\.0{1,7})?)?Z?)?$",
      "description": "UTC or offset-free date/time, years 1980..2039, with whole-minute precision."
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fileSystem": {
          "enum": [
            "dos33",
            "prodos"
          ]
        },
        "template": {
          "type": [
            "string",
            "null"
          ]
        },
        "templateSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "blocks": {
          "type": "integer",
          "minimum": 280,
          "maximum": 65535
        },
        "container": {
          "enum": [
            "raw",
            "2mg"
          ]
        },
        "order": {
          "enum": [
            "dos",
            "prodos",
            null
          ]
        },
        "volumeName": {
          "type": "string"
        },
        "volumeNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 254
        }
      },
      "required": []
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "asm",
              "basic",
              "basic-labels",
              "binary",
              "text",
              "applesingle",
              "cc65",
              "lores",
              "hires",
              "hires-color"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "origin": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 65535
          },
          "auxType": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 65535
          },
          "entryPoint": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 65535
          },
          "replace": {
            "type": "boolean"
          },
          "resident": {
            "type": "boolean"
          },
          "memoryBank": {
            "enum": [
              "main",
              "aux",
              "lc1",
              "lc2",
              "aux-lc1",
              "aux-lc2"
            ],
            "default": "main",
            "description": "Physical residency; banked BIN files require a main-memory loader. This does not change disk load metadata or generate bank-switching code."
          },
          "checkBasic": {
            "type": "boolean"
          },
          "overlayGroup": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "runtimeMemory": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "length": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65536
                },
                "memoryBank": {
                  "enum": [
                    "main",
                    "aux",
                    "lc1",
                    "lc2",
                    "aux-lc1",
                    "aux-lc2"
                  ],
                  "default": "main"
                },
                "kind": {
                  "enum": [
                    "data",
                    "bss",
                    "zero-page",
                    "stack",
                    "heap"
                  ]
                }
              },
              "required": [
                "name",
                "start",
                "length"
              ]
            },
            "maxItems": 1024
          }
        },
        "required": [
          "source",
          "path"
        ]
      },
      "maxItems": 1024,
      "minItems": 0
    },
    "reserve": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536
          },
          "memoryBank": {
            "enum": [
              "main",
              "aux",
              "lc1",
              "lc2",
              "aux-lc1",
              "aux-lc2"
            ],
            "default": "main"
          },
          "kind": {
            "enum": [
              "data",
              "bss",
              "zero-page",
              "stack",
              "heap"
            ]
          }
        },
        "required": [
          "name",
          "start",
          "length"
        ]
      },
      "maxItems": 1024
    },
    "checkMemory": {
      "type": "boolean"
    },
    "basicWorkspaceBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "startup": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "program": {
          "type": "string"
        },
        "replace": {
          "type": "boolean"
        }
      },
      "required": [
        "program"
      ]
    },
    "boot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "asm",
            "binary"
          ]
        },
        "origin": {
          "const": 2048
        },
        "sectors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "required": [
        "source"
      ]
    },
    "execution": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "suite": {
          "type": "string",
          "minLength": 1
        },
        "diskDevice": {
          "enum": [
            "flop1",
            "flop2",
            "hard1",
            "hard2"
          ],
          "default": "flop1"
        }
      },
      "required": [
        "suite"
      ]
    },
    "cc65": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "compiler": {
          "type": "string"
        },
        "target": {
          "enum": [
            "apple2",
            "apple2enh"
          ]
        },
        "expectedVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "optimize": {
          "type": "boolean"
        },
        "additionalSources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 128
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 128
        },
        "defines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 128
        },
        "linkerConfig": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "toolchainRoot": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "segmentBanks": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "main",
              "aux",
              "lc1",
              "lc2",
              "aux-lc1",
              "aux-lc2"
            ]
          }
        }
      },
      "required": []
    },
    "environment": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "toolchainLock": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "runtime": {
      "enum": [
        "auto",
        "basic-system",
        "system"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]{0,47}$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "sprite",
              "tile",
              "font",
              "shapes",
              "dhires",
              "lores",
              "hires",
              "hires-color"
            ]
          },
          "cellWidth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "cellHeight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "bitsPerByte": {
            "enum": [
              7,
              8
            ]
          },
          "bitOrder": {
            "enum": [
              "lsb",
              "msb"
            ]
          },
          "threshold": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "invert": {
            "type": "boolean"
          },
          "firstCodePoint": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1114111
          },
          "mode": {
            "enum": [
              "mono",
              "color"
            ]
          },
          "bankOrder": {
            "enum": [
              "aux-main",
              "main-aux"
            ]
          },
          "assemblyInclude": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "cHeader": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "metadataOutput": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "name",
          "source",
          "output"
        ]
      },
      "maxItems": 128
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "boot"
        ],
        "properties": {
          "boot": {
            "type": "object"
          }
        }
      },
      "then": {
        "required": [
          "disk"
        ],
        "properties": {
          "disk": {
            "required": [
              "fileSystem"
            ],
            "properties": {
              "fileSystem": {
                "const": "dos33"
              },
              "blocks": {
                "const": 280
              },
              "order": {
                "enum": [
                  "dos",
                  null
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "files": { "maxItems": 0 } },
        "required": ["files"]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "disk": {
                "required": ["template"],
                "properties": { "template": { "type": "string", "minLength": 1 } }
              }
            },
            "required": ["disk"]
          },
          {
            "properties": { "boot": { "type": "object" } },
            "required": ["boot"]
          }
        ]
      }
    }
  ],
  "required": [
    "schemaVersion",
    "files"
  ]
}
