{
  "schemaVersion": 1,
  "name": "DOS data disk program",
  "emulatorPath": "tools/mame",
  "romDirectory": "roms",
  "machine": "apple2ee",
  "disks": [{ "device": "flop1", "image": "dos33-boot.do" }],
  "emulatedSeconds": 25,
  "hostTimeoutSeconds": 60,
  "keys": [
    { "atSeconds": 10, "text": "CATALOG,D2\r" },
