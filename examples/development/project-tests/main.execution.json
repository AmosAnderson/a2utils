    { "atSeconds": 14, "text": "CALL 8192\r" }
  ],
  "symbolicMemory": [{ "program": "MAIN", "symbol": "RESULT", "hex": "2A" }],
  "symbolicUntil": { "program": "MAIN", "symbol": "RESULT", "value": 42, "afterSeconds": 15 },
  "diskAssertions": [{ "device": "flop2", "path": "MAIN", "type": "BIN", "auxType": 8192 }],
