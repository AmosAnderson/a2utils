10 HOME
20 F$="SAMPLE.DATA":W$="APPLE II FILE I/O"
30 GOSUB 1000
40 GOSUB 2000
50 PRINT "READ BACK: ";R$
60 END
1000 REM WRITE ONE TEXT RECORD: F$=FILE,W$=TEXT
1010 ONERR GOTO 9000
1020 PRINT CHR$(4);"OPEN ";F$
1030 PRINT CHR$(4);"WRITE ";F$
1040 PRINT W$
1050 PRINT CHR$(4);"CLOSE ";F$
1060 POKE 216,0:RETURN
2000 REM READ ONE TEXT RECORD: F$=FILE,RETURNS R$
2010 ONERR GOTO 9000
2020 PRINT CHR$(4);"OPEN ";F$
2030 PRINT CHR$(4);"READ ";F$
2040 INPUT R$
2050 PRINT CHR$(4);"CLOSE ";F$
2060 POKE 216,0:RETURN
9000 REM CLOSE OUTPUT HOOK BEFORE PRINTING ERROR
9010 E=PEEK(222):POKE 216,0
9020 PRINT CHR$(4);"CLOSE"
9030 PRINT "FILE ERROR ";E:END
