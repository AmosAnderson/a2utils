<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>a2</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>a2</ToolCommandName>
    <PackageId>A2Utils.Tool</PackageId>
    <Description>Command-line utilities for Apple II disk images.</Description>
    <Authors>A2Utils contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../A2Utils.Core/A2Utils.Core.csproj" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <Content Include="../../THIRD_PARTY.md" Link="THIRD_PARTY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../notices/System.CommandLine/LICENSE.md" Link="notices/System.CommandLine/LICENSE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../third_party/CiderPress2/LICENSE" Link="notices/CiderPress2/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../third_party/CiderPress2/NOTICE" Link="notices/CiderPress2/NOTICE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../third_party/CiderPress2/THIRD_PARTY_NOTICES" Link="notices/CiderPress2/THIRD_PARTY_NOTICES" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
